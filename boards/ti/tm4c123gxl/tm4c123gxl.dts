/dts-v1/;

#include <ti/tm4c123gh6pm.dtsi>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/pinctrl/tiva-c-pinctrl.h>
#include <dt-bindings/pwm/pwm.h>

/*
 * Pin configuration nodes for UART0 and UART1.
 * Use TIVA_C_PINMUX(port, pin, mux, type) macro.
 */
&pinctrl {
	uart0_rx_pa0: uart0_rx_pa0 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_A, 0, 1, TIVA_C_TYPE_UART)>;
	};

	uart0_tx_pa1: uart0_tx_pa1 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_A, 1, 1, TIVA_C_TYPE_UART)>;
	};

	uart1_rx_pb0: uart1_rx_pb0 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_B, 0, 1, TIVA_C_TYPE_UART)>;
	};

	uart1_tx_pb1: uart1_tx_pb1 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_B, 1, 1, TIVA_C_TYPE_UART)>;
	};

	/* PWM pins for RGB LED (PF1/PF2/PF3) */
	pwm_red_pf1: pwm_red_pf1 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_F, 1, 7, TIVA_C_TYPE_PWM)>;
	};

	pwm_green_pf2: pwm_green_pf2 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_F, 2, 7, TIVA_C_TYPE_PWM)>;
	};

	pwm_blue_pf3: pwm_blue_pf3 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_F, 3, 7, TIVA_C_TYPE_PWM)>;
	};

	/* USB DP/DM analog pins (PD0/PD1) */
	usb0_dm_pd4: usb0_dm_pd4 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_D, 4, 0, TIVA_C_TYPE_USB_ANALOG)>;
	};

	usb0_dp_pd5: usb0_dp_pd5 {
		pinmux = <TIVA_C_PINMUX(TIVA_C_PORT_D, 5, 0, TIVA_C_TYPE_USB_ANALOG)>;
	};
};

/ {
	model = "TI Tiva C Series TM4C123GXL LaunchPad";
	compatible = "ti,tm4c123gxl";

	aliases {
		led0 = &led_red;
		led1 = &led_blue;
		led2 = &led_green;
		pwm-led0 = &pwm_red;
		pwm-led1 = &pwm_green;
		pwm-led2 = &pwm_blue;
		red-pwm-led = &pwm_red;
		green-pwm-led = &pwm_green;
		blue-pwm-led = &pwm_blue;
		sw0 = &user_button_sw1;
		sw1 = &user_button_sw2;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	leds {
		compatible = "gpio-leds";
		led_red: led_red {
			gpios = <&gpio5 1 GPIO_ACTIVE_HIGH>;
			label = "RED LED (PF1)";
		};
		led_blue: led_blue {
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
			label = "BLUE LED (PF2)";
		};
		led_green: led_green {
			gpios = <&gpio5 3 GPIO_ACTIVE_HIGH>;
			label = "GREEN LED (PF3)";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		pwm_red: pwm_red {
			pwms = <&timer0 1 20000000 PWM_POLARITY_NORMAL>;
			label = "Red PWM LED (PF1)";
		};

		pwm_green: pwm_green {
			pwms = <&timer0 0 20000000 PWM_POLARITY_NORMAL>;
			label = "Green PWM LED (PF2)";
		};

		pwm_blue: pwm_blue {
			pwms = <&timer1 0 20000000 PWM_POLARITY_NORMAL>;
			label = "Blue PWM LED (PF3)";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_sw1: button_sw1 {
			label = "User SW1";
			gpios = <&gpio5 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button_sw2: button_sw2 {
			label = "User SW2";
			gpios = <&gpio5 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

/* UART0 is connected to the on-board ICDI virtual COM port (PA0/PA1) */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_pa0 &uart0_tx_pa1>;
	pinctrl-names = "default";
};

/* UART1 on header pins PB0/PB1 */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_rx_pb0 &uart1_tx_pb1>;
	pinctrl-names = "default";
};

/* GPIO Port F: RGB LED (PF1/PF2/PF3) and buttons (PF0/PF4) */
&gpio5 {
	status = "okay";
	label = "GPIOF";
};

/* Hibernation RTC (32.768 kHz crystal on board) */
&hib {
	status = "okay";
};

/* PWM Timer 0 and Timer 1 (for RGB LED on PF1/PF2/PF3) */
&timer0 {
	status = "okay";
	pinctrl-0 = <&pwm_green_pf2 &pwm_red_pf1>;
	pinctrl-names = "default";
};

&timer1 {
	status = "okay";
	pinctrl-0 = <&pwm_blue_pf3>;
	pinctrl-names = "default";
};

/* USB0 device controller (PD0=DM, PD1=DP)
 * Note: USB signals are on BoosterPack headers, not on the debug USB port.
 * External wiring required for testing.
 */
zephyr_udc0: &usb0 {
	status = "okay";
	pinctrl-0 = <&usb0_dm_pd4 &usb0_dp_pd5>;
	pinctrl-names = "default";
};
